    "scenario": "IBGP-Internal BGP",
    "goals": "\u2022 Configure IBGP AS {{bgp_as}} on all routers. You are only allowed to use Loopback0 to establish the neighbor adjacency.\n\u2022 Advertise the loopback1 interfaces in IBGP and ensure you have full connectivity within AS {{bgp_as}}.",
    "startup_configs": {
        "{{router1_name}}": [
            "config interface ip remove Loopback0 10.1.0.1/32",
            "config interface ip add Loopback0 {{router1_lo0_ip}}/24",
            "config loopback add Loopback1",
            "config interface ip add Loopback1 {{router1_lo1_ip}}/24",
            "config interface ip add {{router1_link1_iface}} {{link1_ip1}}/{{link1_prefix_len}}",
            "config interface startup {{router1_link1_iface}}",
            "config interface ip add {{router1_link2_iface}} {{link2_ip1}}/{{link2_prefix_len}}",
            "config interface startup {{router1_link2_iface}}"
        ],
        "{{router2_name}}": [
            "config interface ip remove Loopback0 10.1.0.1/32",
            "config interface ip add Loopback0 {{router2_lo0_ip}}/24",
            "config loopback add Loopback1",
            "config interface ip add Loopback1 {{router2_lo1_ip}}/24",
            "config interface ip add {{router2_link3_iface}} {{link3_ip1}}/{{link3_prefix_len}}",
            "config interface startup {{router2_link3_iface}}",
            "config interface ip add {{router2_link2_iface}} {{link2_ip2}}/{{link2_prefix_len}}",
            "config interface startup {{router2_link2_iface}}"
        ],
        "{{router3_name}}": [
            "config interface ip remove Loopback0 10.1.0.1/32",
            "config interface ip add Loopback0 {{router3_lo0_ip}}/24",
            "config loopback add Loopback1",
            "config interface ip add Loopback1 {{router3_lo1_ip}}/24",
            "config interface ip add {{router3_link4_iface}} {{link4_ip1}}/{{link4_prefix_len}}",
            "config interface startup {{router3_link4_iface}}",
            "config interface ip add {{router3_link1_iface}} {{link1_ip2}}/{{link1_prefix_len}}",
            "config interface startup {{router3_link1_iface}}"
        ],
        "{{router4_name}}": [
            "config interface ip remove Loopback0 10.1.0.1/32",
            "config interface ip add Loopback0 {{router4_lo0_ip}}/24",
            "config loopback add Loopback1",
            "config interface ip add Loopback1 {{router4_lo1_ip}}/24",
            "config interface ip add {{router4_link3_iface}} {{link3_ip2}}/{{link3_prefix_len}}",
            "config interface startup {{router4_link3_iface}}",
            "config interface ip add {{router4_link4_iface}} {{link4_ip2}}/{{link4_prefix_len}}",
            "config interface startup {{router4_link4_iface}}"
        ]
    },
    "groundtruth_configs": {
        "{{router1_name}}": [
            "ip route {{router2_lo0_network}}/24 {{link2_ip2}}",
            "ip route {{router3_lo0_network}}/24 {{link1_ip2}}",
            "ip route {{router4_lo0_network}}/24 {{link2_ip2}}",
