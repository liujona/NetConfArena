            "index": 2
        },
        "router3_lo0_network": {
            "type": "subnet_attr",
            "subnet": "_r3_lo0",
            "attr": "network"
        },
        "router3_lo0_mask": {
            "type": "subnet_attr",
            "subnet": "_r3_lo0",
            "attr": "netmask"
        },
        "_r4_lo0": {
            "type": "random_subnet",
            "pool": "r4_lo0_pool",
            "prefix_len": 24,
            "default": "1.1.1.0/24"
        },
        "router4_lo0_ip": {
            "type": "subnet_attr",
            "subnet": "_r4_lo0",
            "attr": "host",
