    "scenario": "EBGP-External BGP",
    "goals": "• Configure EBGP between {{router4_name}} (AS {{as1}}) and {{router3_name}} (AS {{as2}}).\n• Configure EBGP between {{router3_name}} (AS {{as2}}) and {{router2_name}} (AS {{as3}}). You are not allowed to use the IP addresses on the physical interfaces to configure the BGP neighbor adjacency.\n• Configure EBGP between {{router2_name}} (AS {{as3}}) and {{router1_name}} (AS {{as4}}).\n• Advertise all the loopback interfaces in BGP and ensure you have full reachability for these networks.",
    "startup_configs": {
        "{{router1_name}}": [
            "config interface ip remove Loopback0 10.1.0.1/32",
            "config interface ip add Loopback0 {{router1_lo0_ip}}/{{r1_lo0_prefix_len}}",
            "route-map RM_SET_SRC permit 10",
            "set src {{router1_lo0_ip}}",
            "exit",
            "config interface ip add {{router1_link1_iface}} {{link1_ip1}}/{{link1_prefix_len}}",
            "config interface startup {{router1_link1_iface}}"
        ],
        "{{router2_name}}": [
            "config interface ip remove Loopback0 10.1.0.1/32",
            "config interface ip add Loopback0 {{router2_lo0_ip}}/{{r2_lo0_prefix_len}}",
            "route-map RM_SET_SRC permit 10",
            "set src {{router2_lo0_ip}}",
            "exit",
            "config interface ip add {{router2_link2_iface}} {{link2_ip1}}/{{link2_prefix_len}}",
            "config interface startup {{router2_link2_iface}}",
            "config interface ip add {{router2_link1_iface}} {{link1_ip2}}/{{link1_prefix_len}}",
            "config interface startup {{router2_link1_iface}}"
        ],
        "{{router3_name}}": [
            "config interface ip remove Loopback0 10.1.0.1/32",
            "config interface ip add Loopback0 {{router3_lo0_ip}}/{{r3_lo0_prefix_len}}",
            "route-map RM_SET_SRC permit 10",
            "set src {{router3_lo0_ip}}",
            "exit",
            "config interface ip add {{router3_link3_iface}} {{link3_ip1}}/{{link3_prefix_len}}",
            "config interface startup {{router3_link3_iface}}",
            "config interface ip add {{router3_link2_iface}} {{link2_ip2}}/{{link2_prefix_len}}",
            "config interface startup {{router3_link2_iface}}"
        ],
        "{{router4_name}}": [
            "config interface ip remove Loopback0 10.1.0.1/32",
            "config interface ip add Loopback0 {{router4_lo0_ip}}/{{r4_lo0_prefix_len}}",
            "route-map RM_SET_SRC permit 10",
            "set src {{router4_lo0_ip}}",
            "exit",
            "config interface ip add {{router4_link3_iface}} {{link3_ip2}}/{{link3_prefix_len}}",
            "config interface startup {{router4_link3_iface}}"
        ]
    },
    "groundtruth_configs": {
        "{{router1_name}}": [
            "router bgp {{as4}}",
            "bgp router-id {{router1_lo0_ip}}",
            "no bgp ebgp-requires-policy",
            "neighbor {{link1_ip2}} remote-as {{as3}}",
            "address-family ipv4 unicast",
            "network {{router1_lo0_network}}/{{r1_lo0_prefix_len}}",
            "network {{link1_network}}/{{link1_prefix_len}}",
            "exit-address-family",
            "exit"
        ],
        "{{router2_name}}": [
            "router bgp {{as3}}",
            "bgp router-id {{router2_lo0_ip}}",
            "no bgp ebgp-requires-policy",
            "neighbor {{router3_lo0_ip}} remote-as {{as2}}",
            "neighbor {{router3_lo0_ip}} ebgp-multihop 2",
            "neighbor {{router3_lo0_ip}} update-source Loopback0",
            "neighbor {{link1_ip1}} remote-as {{as4}}",
            "address-family ipv4 unicast",
            "network {{router2_lo0_network}}/{{r2_lo0_prefix_len}}",
            "exit-address-family",
            "exit",
            "ip route {{router3_lo0_ip}}/32 {{link2_ip2}}"
        ],
        "{{router3_name}}": [
            "router bgp {{as2}}",
            "bgp router-id {{router3_lo0_ip}}",
            "no bgp ebgp-requires-policy",
            "neighbor {{router2_lo0_ip}} remote-as {{as3}}",
            "neighbor {{router2_lo0_ip}} ebgp-multihop 2",
            "neighbor {{router2_lo0_ip}} update-source Loopback0",
            "neighbor {{link3_ip2}} remote-as {{as1}}",
            "address-family ipv4 unicast",
            "network {{router3_lo0_network}}/{{r3_lo0_prefix_len}}",
            "network {{link2_network}}/{{link2_prefix_len}}",
            "exit-address-family",
            "exit",
            "ip route {{router2_lo0_ip}}/32 {{link2_ip1}}"
        ],
        "{{router4_name}}": [
            "router bgp {{as1}}",
            "bgp router-id {{router4_lo0_ip}}",
            "no bgp ebgp-requires-policy",
            "neighbor {{link3_ip1}} remote-as {{as2}}",
            "address-family ipv4 unicast",
            "network {{router4_lo0_network}}/{{r4_lo0_prefix_len}}",
            "network {{link3_network}}/{{link3_prefix_len}}",
            "exit-address-family",
            "exit"
        ]
    },
    "testcases": [
        {
            "goal": "Configure EBGP between {{router4_name}} (AS {{as1}}) and {{router3_name}} (AS {{as2}}).",
            "testcase": [
                {
                    "id": "1-1",
                    "node": "{{router4_name}}",
                    "command": "sudo vtysh -c \"show ip bgp neighbors json\"",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "remote_as": "{{as2}}",
                                "bgp_state": "Established"
                            }
                        ]
                    }
                },
                {
                    "id": "1-2",
                    "node": "{{router3_name}}",
                    "command": "sudo vtysh -c \"show ip bgp neighbors json\"",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "remote_as": "{{as1}}",
                                "bgp_state": "Established"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Configure EBGP between {{router3_name}} (AS {{as2}}) and {{router2_name}} (AS {{as3}}). You are not allowed to use the IP addresses on the physical interfaces to configure the BGP neighbor adjacency.",
            "testcase": [
                {
                    "id": "2-1",
                    "node": "{{router3_name}}",
                    "command": "sudo vtysh -c \"show ip bgp neighbors json\"",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "neighbor": "{{router2_lo0_ip}}",
                                "remote_as": "{{as3}}",
                                "bgp_state": "Established"
                            }
                        ]
                    }
                },
                {
                    "id": "2-2",
