            "attr": "host",
            "index": 3
        },
        "router2_lo0_network": {
            "type": "subnet_attr",
            "subnet": "_r2_lo0",
            "attr": "network"
        },
        "router2_lo0_mask": {
            "type": "subnet_attr",
            "subnet": "_r2_lo0",
            "attr": "netmask"
        },
        "_r3_lo0": {
            "type": "random_subnet",
            "pool": "r3_lo0_pool",
            "prefix_len": 24,
            "default": "2.2.2.0/24"
        },
        "router3_lo0_ip": {
            "type": "subnet_attr",
            "subnet": "_r3_lo0",
