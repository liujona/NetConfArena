{
    "params": {
        "as1": {
            "type": "fixed",
            "default": "1"
        },
        "as2": {
            "type": "fixed",
            "default": "2"
        },
        "as3": {
            "type": "fixed",
            "default": "3"
        },
        "as4": {
            "type": "fixed",
            "default": "4"
        },
        "router1_name": {
            "type": "choice",
            "options": "r1_names"
        },
        "router2_name": {
            "type": "choice",
            "options": "r2_names",
            "different_from": [
                "router1_name"
            ]
        },
        "router3_name": {
            "type": "choice",
            "options": "r3_names",
            "different_from": [
                "router1_name",
                "router2_name"
            ]
        },
        "router4_name": {
            "type": "choice",
            "options": "r4_names",
            "different_from": [
                "router1_name",
                "router2_name",
                "router3_name"
            ]
        },
        "_r1_lo0": {
            "type": "random_subnet",
            "pool": "r1_lo0_pool",
            "prefix_len": 24,
            "default": "4.4.4.0/24"
