                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Configure EBGP between {{router2_name}} (AS {{as3}}) and {{router1_name}} (AS {{as4}}).",
            "testcase": [
                {
                    "id": "3-1",
                    "node": "{{router2_name}}",
                    "command": "sudo vtysh -c \"show ip bgp neighbors json\"",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "remote_as": "{{as4}}",
                                "bgp_state": "Established"
                            }
                        ]
                    }
                },
                {
                    "id": "3-2",
                    "node": "{{router1_name}}",
                    "command": "sudo vtysh -c \"show ip bgp neighbors json\"",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "remote_as": "{{as3}}",
                                "bgp_state": "Established"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Advertise all the loopback interfaces in BGP and ensure you have full reachability for these networks.",
            "testcase": [
                {
                    "id": "4-1",
                    "node": "{{router1_name}}",
                    "command": "ping -c 5 -I Loopback0 {{router2_lo0_ip}}",
                    "expected_result": {
                        "success_pct": {
                            "op": ">",
