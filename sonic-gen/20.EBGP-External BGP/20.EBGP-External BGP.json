        "router4_lo0_network": {
            "type": "subnet_attr",
            "subnet": "_r4_lo0",
            "attr": "network"
        },
        "router4_lo0_mask": {
            "type": "subnet_attr",
            "subnet": "_r4_lo0",
            "attr": "netmask"
